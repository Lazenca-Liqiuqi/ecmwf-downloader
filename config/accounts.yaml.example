# 账号池配置文件
# 管理多个 CDS API 账号，支持轮换使用

# 连续失败多少次后自动禁用账号
auto_disable_threshold: 5

# 账号列表
# 每个账号需要填写以下信息：
#   - email: CDS 账号邮箱（用于显示标识，必填）
#   - key: CDS API Key（UUID 格式，从 CDS 网站获取，必填）
#   - url: API 地址（可选，通常使用默认值）
accounts: []
  # 示例账号（请替换为您自己的账号信息）
  # - email: your-email@example.com
  #   key: your-api-key-here
  #   url: https://cds.climate.copernicus.eu/api
  #   status: active
