# ECMWF下载器默认配置文件
#
# 此文件定义应用程序的默认行为和参数
# 用户可以根据需要修改此文件，或创建自定义配置文件

# ============================================================================
# 下载任务配置
# ============================================================================
# 注意：数据集 ID 和参数在 TUI 界面中输入，由动态表单从 API 获取
# 支持的数据集示例：
#   - reanalysis-era5-pressure-levels (ERA5 气压层数据)
#   - reanalysis-era5-single-levels (ERA5 单层数据)
#   - reanalysis-era5-land (ERA5-Land 数据)

download:
  # 输出目录（绝对路径或相对路径）
  output_dir: "./data/downloads"

  # 输出文件格式
  output_format: "netcdf"

# ============================================================================
# 并发下载配置
# ============================================================================
concurrency:
  # 每批处理的任务数
  batch_size: 4

  # 最大并发线程数
  max_workers: 4

  # 批次间延迟（秒）
  batch_delay: 1.0

  # 单个任务最大重试次数
  max_retries: 3

  # 重试延迟（秒）
  retry_delay: 5.0

# ============================================================================
# 进度管理配置
# ============================================================================
progress:
  # 是否启用进度保存（支持断点续传）
  enabled: true

  # 进度文件路径
  file_path: "./data/download_progress.json"

  # 自动保存间隔（秒）
  auto_save_interval: 5

# ============================================================================
# 日志配置
# ============================================================================
logging:
  # 日志级别：DEBUG, INFO, WARNING, ERROR, CRITICAL
  level: "INFO"

  # 日志文件路径（不指定则仅输出到控制台）
  file_path: "./data/logs/ecmwf_downloader.log"

  # 是否输出到控制台
  console_output: true

  # 日志文件最大大小（字节，默认10MB）
  max_bytes: 10485760

  # 保留的日志备份数量
  backup_count: 3

# ============================================================================
# 其他配置预留
# ============================================================================
# future:
#   代理配置
#   速度限制
#   通知设置
